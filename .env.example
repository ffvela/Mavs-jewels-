# Copia este archivo como .env y completa los valores. El archivo .env nunca se sube al repositorio.

# Aplicación
APP_ENV=local
APP_URL=http://localhost:8080

# Base de datos MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mavs_jewelry
DB_USER=mavs
DB_PASS=

# Mercado Pago (Tus integraciones > tu aplicación > Credenciales)
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones > Webhooks > Configurar notificaciones)
MP_WEBHOOK_SECRET=

# Correo (cuenta SMTP del hosting)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=ventas@mavsjewelry.cl
CORREO_PROPIETARIA=mavenegas.s.mv@gmail.com

# WhatsApp del negocio, con código de país y sin "+"
WHATSAPP=56989234239

# Carpeta privada de respaldos (fuera de public/). Por defecto: respaldos/ en la raíz del proyecto
RESPALDO_DIR=
